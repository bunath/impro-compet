PORT=8787
# URL publique Tailscale Funnel (sert à fabriquer les liens des emails)
PUBLIC_URL=https://MACHINE.TAILNET.ts.net
DATA_DIR=/var/lib/impro-regie
# 1 = le serveur répond 503 hors 22h–7h (Europe/Paris). 0 pour tester.
ENFORCE_HOURS=1
# Brevo (laisser vide = les emails sont affichés dans les logs, pour tester)
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@ton-domaine.fr
MAIL_FROM_NAME=Impro Régie
